{
  "name": "@hykr/api",
  "version": "0.1.0",
  "description": "Basecamp's server as a library: NestJS API, queue worker and templates CLI for an application's domain.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./testing/internals": {
      "types": "./dist/testing-internals.d.ts",
      "default": "./dist/testing-internals.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsc -p test/fixture/tsconfig.json && vitest run"
  },
  "dependencies": {
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@hykr/agents": "workspace:*",
    "@hykr/api-client": "workspace:*",
    "@hykr/channels": "workspace:*",
    "@hykr/contracts": "workspace:*",
    "@hykr/core": "workspace:*",
    "@hykr/db": "workspace:*",
    "@hykr/i18n": "workspace:*",
    "@hykr/notifications": "workspace:*",
    "@hykr/policy": "workspace:*",
    "@hykr/ui-registry": "workspace:*",
    "@mastra/ai-sdk": "1.10.6",
    "@mastra/core": "1.74.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "ai": "7.0.128",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "livekit-server-sdk": "2.19.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.15",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  },
  "publishConfig": {
    "access": "public"
  }
}
