{
  "name": "@hykr/core",
  "version": "0.1.0",
  "description": "Basecamp's core: defineEntity / defineCommand, the write path (rules, approvals, audit), list grammar and generated agent tools.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "default": "./dist/tools/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hykr/api-client": "workspace:*",
    "@hykr/contracts": "workspace:*",
    "@hykr/i18n": "workspace:*",
    "@hykr/db": "workspace:*",
    "@hykr/policy": "workspace:*",
    "@hykr/ui-registry": "workspace:*",
    "@mastra/core": "1.74.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/cqrs": "^11.0.3",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "ai": "7.0.128",
    "drizzle-orm": "^0.45.3",
    "nestjs-zod": "^5.5.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
