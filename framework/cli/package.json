{
  "name": "@hykr/cli",
  "version": "0.1.0",
  "description": "The basecamp command: run, migrate, evaluate and serve an application built on Basecamp.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "basecamp": "./bin/basecamp.js"
  },
  "files": [
    "bin",
    "dist",
    "compose.yaml",
    "infra"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hykr/voice-worker": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
