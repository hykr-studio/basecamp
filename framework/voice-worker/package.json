{
  "name": "@hykr/voice-worker",
  "version": "0.1.0",
  "description": "Basecamp's LiveKit voice worker: speech in, a chat turn for the person at the API, speech and UI parts out.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "basecamp-voice-worker": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "exports": {
    "./say": {
      "types": "./dist/say.d.ts",
      "default": "./dist/say.js"
    },
    "./turn": {
      "types": "./dist/turn.d.ts",
      "default": "./dist/turn.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@hykr/api-client": "workspace:*",
    "@hykr/contracts": "workspace:*",
    "@hykr/i18n": "workspace:*",
    "@livekit/agents": "1.9.1",
    "@livekit/agents-plugin-sarvam": "1.9.1",
    "@livekit/agents-plugin-silero": "1.9.1",
    "@livekit/rtc-node": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
