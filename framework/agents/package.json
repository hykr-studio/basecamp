{
  "name": "@hykr/agents",
  "version": "0.1.0",
  "description": "Basecamp's assistant: Mastra agents over an application's catalog, a scripted model, scorers, evals and Studio.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./script": {
      "types": "./dist/script.d.ts",
      "default": "./dist/script.js"
    },
    "./evals": {
      "types": "./dist/evals/index.d.ts",
      "default": "./dist/evals/index.js"
    },
    "./studio": {
      "types": "./dist/studio.d.ts",
      "default": "./dist/studio.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "3.0.63",
    "@ai-sdk/provider": "^2.0.3",
    "@hono/node-server": "^1.19.17",
    "@hykr/api-client": "workspace:*",
    "@hykr/contracts": "workspace:*",
    "@hykr/core": "workspace:*",
    "@hykr/i18n": "workspace:*",
    "@hykr/ui-registry": "workspace:*",
    "@mastra/core": "1.74.0",
    "@mastra/evals": "1.10.5",
    "@mastra/hono": "1.7.16",
    "@mastra/loggers": "1.3.4",
    "@mastra/memory": "1.35.0",
    "@mastra/observability": "1.18.3",
    "@mastra/pg": "1.29.0",
    "ai": "7.0.128",
    "hono": "^4.13.13",
    "mastra": "1.32.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "vitest": "^5.0.3"
  },
  "publishConfig": {
    "access": "public"
  }
}
