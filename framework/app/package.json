{
  "name": "@hykr/app",
  "version": "0.1.0",
  "description": "Basecamp's Expo app as a library: the shell, the assistant's thread and canvas, approvals, and the components an application builds its screens from.",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    },
    "./theme.css": "./theme.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "theme.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node scripts/check-tokens.mjs"
  },
  "dependencies": {
    "@assistant-ui/ai-sdk": "^0.0.11",
    "@assistant-ui/react-native": "^0.1.46",
    "@better-auth/expo": "^1.7.7",
    "@expo-google-fonts/schibsted-grotesk": "^0.4.2",
    "@hykr/api-client": "workspace:*",
    "@hykr/contracts": "workspace:*",
    "@hykr/i18n": "workspace:*",
    "@hykr/ui-registry": "workspace:*",
    "@rn-primitives/checkbox": "^1.5.2",
    "@rn-primitives/separator": "^1.5.2",
    "@rn-primitives/slot": "^1.5.2",
    "ai": "7.0.128",
    "better-auth": "^1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "peerDependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@livekit/react-native": "3.0.0",
    "@tanstack/react-query": "^5",
    "expo": "~57.0.27",
    "expo-font": "^57.0.4",
    "expo-router": "~57.0.25",
    "expo-secure-store": "^57.0.4",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "livekit-client": "2.22.3",
    "react": "^19.2.0",
    "react-native": ">=0.86.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "uniwind": "^1.12.2"
  },
  "devDependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@livekit/react-native": "3.0.0",
    "@livekit/react-native-webrtc": "144.2.0",
    "@tanstack/react-query": "^5.104.1",
    "@types/react": "~19.2.2",
    "expo": "~57.0.27",
    "expo-font": "^57.0.4",
    "expo-router": "~57.0.25",
    "expo-secure-store": "^57.0.4",
    "expo-speech": "~57.0.3",
    "expo-sqlite": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "livekit-client": "2.22.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-worklets": "0.10.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "uniwind": "^1.12.2"
  }
}
