{
  "name": "@hykr/contracts",
  "version": "0.1.0",
  "description": "Basecamp's contracts: entity and command specs (Zod), the catalog, shared types.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hykr/i18n": "workspace:*",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
