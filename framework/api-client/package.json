{
  "name": "@hykr/api-client",
  "version": "0.1.0",
  "description": "Basecamp's typed API client, for apps, the assistant and the voice worker.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hykr/contracts": "workspace:*",
    "zod": "^4.6.5"
  },
  "publishConfig": {
    "access": "public"
  }
}
