    "@hykr/voice-worker": "workspace:*",
    "@nestjs/bullmq": "^12.0.0",
    "@types/node": "^26.6.4",
    "bullmq": "^6.3.11",
    "typescript": "~5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
