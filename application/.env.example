DATABASE_URL=postgres://app:app@localhost:5432/app
MIGRATE_DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=      # openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:8081,http://localhost:8082
PLATFORM_TENANT_ID=      # the business whose rows of shared entities every business reads; empty: none
AGENT_API_KEY=           # openssl rand -hex 32
API_INTERNAL_URL=http://localhost:3000
# IDEMPOTENCY_KEEP_DAYS=30   # how long a write's reply is kept for a retry with its key (offline phones)
# The assistant's models, as <provider>/<model>. Development: OpenRouter with your key.
OPENROUTER_API_KEY=
AGENT_MODEL=openrouter/openai/gpt-6-luna   # the default chat model
OPENROUTER_MODELS=       # more OpenRouter chat models a business may allow, comma-separated
EMBEDDING_MODEL=         # the default embedding model (memory recall); none on OpenRouter here
# Production: the in-country OpenAI-compatible gateway, on one line. The key stays in the
# variable apiKeyEnv names; a business's policy can require region "in". Prices are minor units
# of the currency per million tokens (what credits are metered on).
# MODEL_PROVIDERS='[{"id":"gateway","baseUrl":"https://llm.example.in/v1","apiKeyEnv":"GATEWAY_API_KEY","region":"in","models":[{"id":"large","label":"Large","price":{"currency":"INR","inputPerMillion":1500,"outputPerMillion":6000}},{"id":"small","label":"Small","price":{"currency":"INR","inputPerMillion":300,"outputPerMillion":1200}},{"id":"embed","kind":"embedding","price":{"currency":"INR","inputPerMillion":50}}]}]'
# GATEWAY_API_KEY=
# AGENT_MODEL=gateway/large
# EMBEDDING_MODEL=gateway/embed
MODEL_MODE=live          # fake = scripted model, no key needed
GUARDRAILS=off

# Credits: what each business's use costs, in minor units (paise) of CREDITS_CONFIG.currency,
# on one line. Prices: tool_calls per call, messages per WhatsApp message (messages.<category>
# per template category), voice_seconds per minute, tokens per million (unset here: each model's
# MODEL_PROVIDERS price, plus markupPercent). "defaults" is every business's plan: on credits,
# 500.00 included each month, alerted at 80%, paused at 100% (no turns, no new voice sessions,
# no marketing messages) until it buys more. Unset: usage is measured, nothing is capped.
CREDITS_CONFIG='{"currency":"INR","prices":{"tool_calls":10,"messages":20,"messages.utility":15,"messages.marketing":90,"voice_seconds":150},"markupPercent":20,"defaults":{"enforce":true,"allowance":50000,"alertAt":80,"pauseAt":100,"pauseMessages":["marketing"]}}'
# Platform operators are named people: after signing up, `pnpm --dir application exec basecamp
# operator add <email>` makes one (developer guide, section 6.6).

# Voice (step 15). LiveKit dev mode runs in Compose with these fixed keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=127.0.0.1     # your Mac's LAN IP to test from a phone on the same Wi-Fi
SARVAM_API_KEY=               # https://dashboard.sarvam.ai (speech-to-text and text-to-speech)
VOICE_AGENT_KEY=              # openssl rand -hex 32; the voice worker's own key, not AGENT_API_KEY
VOICE_MODE=live               # or fake: text in, spoken text and UI parts out, no audio
VOICE_DAILY_MINUTES=30        # per person; past it, POST /api/voice/session returns 429

# WhatsApp (step 16). whaloc stands in for Meta in development and CI: the adapter only
# knows a Graph URL, so switching to Meta is configuration.
WA_GRAPH_URL=http://localhost:8080            # https://graph.facebook.com in staging and production
WA_API_VERSION=v25.0
WA_WABA_ID=666635535888644                    # the business account (whaloc's seed)
WA_PHONE_NUMBER_ID=573542517421694            # the number we send from (whaloc's seed)
WA_ACCESS_TOKEN=dev-token                     # a system-user token in production
WA_APP_SECRET=dev-app-secret                  # HMAC key for X-Hub-Signature-256; = WHALOC_APP_SECRET
WA_VERIFY_TOKEN=dev-verify-token              # Meta's GET webhook challenge
WA_SEND_RATE_PER_SEC=60                       # below Meta's default per-number throughput
APPROVAL_SECRET=                              # signs approval buttons: openssl rand -hex 32
SMTP_HOST=localhost                           # Mailpit in development (http://localhost:8025)
SMTP_PORT=1025
APP_URL=http://localhost:8081                 # links in messages (sign-in, pages, approvals)

# Files (photos, documents, voice notes). s3: MinIO in development (pnpm infra:up), any
# S3-compatible store elsewhere; fs: a folder (STORAGE_DIR); memory: one process only (tests).
# Production refuses memory. The bucket is created at startup when it is missing.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000             # what the API calls
S3_PUBLIC_ENDPOINT=http://localhost:9000      # what upload/download URLs name: your Mac's LAN IP for a phone
S3_REGION=us-east-1
S3_BUCKET=basecamp
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
# STORAGE_DIR=.files                          # STORAGE_DRIVER=fs
# STORAGE_SECRET=                             # signs fs/memory URLs (default: from BETTER_AUTH_SECRET)
# FILES_MAX_BYTES=26214400                    # the largest file any field takes (25 MiB)
# FILES_URL_TTL_S=300                         # download URLs
# FILES_UPLOAD_TTL_S=900                      # upload URLs, and how long an upload waits for its bytes
# FILES_DETACHED_GRACE_H=168                  # a file taken off its record (or never put on one) is deleted after this
# FILES_MAX_PENDING=50                        # unfinished uploads per person per day

# Outside AI clients (Claude, ChatGPT, an IDE) over MCP, with OAuth: the endpoint's public URL,
# which tokens are issued for. A domain of its own may proxy to the API's /mcp. MCP=off: none.
# MCP_URL=https://mcp.example.com/mcp         # default: BETTER_AUTH_URL/mcp
# MCP=off

# Long-running jobs: where outside services post their signed updates, and the key each job's
# callback secret is derived from.
# JOBS_PUBLIC_URL=https://api.example.com     # default: BETTER_AUTH_URL
# JOBS_SECRET=                                # default: from BETTER_AUTH_SECRET
# JOBS_CALLBACK_TOLERANCE_S=300               # how old a callback's signature may be
# JOBS_ALLOW_PRIVATE_URLS=1                   # development only: result URLs on http or a private address

# Documents (PDFs of records). pdf: pdfkit with HarfBuzz and the Noto fonts (Latin, Devanagari,
# Telugu); fake: plain text lines, for tests only (production refuses it).
DOCUMENTS_ENGINE=pdf
# WA_APP_ID=                                  # Meta app id: document templates are created with a sample PDF

# Money. A business without its own currency (tenant settings: money.currency) counts in this
# one (ISO 4217); unset, the framework assumes none (XXX). The sample application counts in INR.
DEFAULT_CURRENCY=INR
JSON_BODY_LIMIT=1mb                           # the largest JSON body: a whole order with its lines

# Push notifications (Expo's push service) and live updates. All optional.
# EXPO_ACCESS_TOKEN=                          # only if the Expo project requires it for sending
# PUSH_RECEIPT_DELAY_MS=60000                 # how old a send is before its receipt is checked
# LIVE_MAX_MS=900000                          # a live stream closes after this; the app reconnects

# Integrations (webhooks out and in). Credentials and signing secrets are stored sealed with
# SECRETS_KEY; without it, endpoints and connections cannot be saved.
SECRETS_KEY=                                  # openssl rand -hex 32
SECRETS_KEY_PREVIOUS=                         # older keys after a change, comma separated
INTEGRATIONS_ALLOWED_HOSTS=                   # e.g. localhost: a development receiver, over http too
INTEGRATIONS_TIMEOUT_MS=10000
INTEGRATIONS_RETRY_SCHEDULE=5s,5m,30m,2h,5h,10h,10h

# Calendars (Google, invites, feeds). Each person connects their own Google account; the tokens
# are sealed with SECRETS_KEY. Without a client id and secret, Google is not offered (invites and
# feeds still work). fake: an in-memory Google, for development and tests (production refuses it).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_TRANSPORT=fake
# GOOGLE_CALENDAR_REDIRECT_URL=               # default: <BETTER_AUTH_URL>/api/calendar/google/callback
# CALENDAR_PUBLIC_URL=https://api.example.com # where Google posts changes and feeds are read (default: BETTER_AUTH_URL; https only for Google)
# CALENDAR_RETURN_URL=                        # where the browser lands after Google, to finish connecting (default: <APP_URL>/calendar)
# CALENDAR_APP_RETURN_URL=agenticstack://calendar   # the same for the native app (its scheme); unset: the web address
# CALENDAR_SYNC_DAYS=90                       # how far ahead a new connection is filled
