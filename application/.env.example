DATABASE_URL=postgres://app:app@localhost:5432/app
MIGRATE_DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=      # openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:8081,http://localhost:8082
AGENT_API_KEY=           # openssl rand -hex 32
API_INTERNAL_URL=http://localhost:3000
# The assistant's models, as <provider>/<model>. Development: OpenRouter with your key.
OPENROUTER_API_KEY=
AGENT_MODEL=openrouter/openai/gpt-6-luna   # the default chat model
OPENROUTER_MODELS=       # more OpenRouter chat models a business may allow, comma-separated
EMBEDDING_MODEL=         # the default embedding model (memory recall); none on OpenRouter here
# Production: the in-country OpenAI-compatible gateway, on one line. The key stays in the
# variable apiKeyEnv names; a business's policy can require region "in". Prices are minor units
# of the currency per million tokens (what credits are metered on).
# MODEL_PROVIDERS='[{"id":"gateway","baseUrl":"https://llm.example.in/v1","apiKeyEnv":"GATEWAY_API_KEY","region":"in","models":[{"id":"large","label":"Large","price":{"currency":"INR","inputPerMillion":1500,"outputPerMillion":6000}},{"id":"small","label":"Small","price":{"currency":"INR","inputPerMillion":300,"outputPerMillion":1200}},{"id":"embed","kind":"embedding","price":{"currency":"INR","inputPerMillion":50}}]}]'
# GATEWAY_API_KEY=
# AGENT_MODEL=gateway/large
# EMBEDDING_MODEL=gateway/embed
MODEL_MODE=live          # fake = scripted model, no key needed
GUARDRAILS=off

# Credits: what each business's use costs, in minor units (paise) of CREDITS_CONFIG.currency,
# on one line. Prices: tool_calls per call, messages per WhatsApp message (messages.<category>
# per template category), voice_seconds per minute, tokens per million (unset here: each model's
# MODEL_PROVIDERS price, plus markupPercent). "defaults" is every business's plan: on credits,
# 500.00 included each month, alerted at 80%, paused at 100% (no turns, no new voice sessions,
# no marketing messages) until it buys more. Unset: usage is measured, nothing is capped.
CREDITS_CONFIG='{"currency":"INR","prices":{"tool_calls":10,"messages":20,"messages.utility":15,"messages.marketing":90,"voice_seconds":150},"markupPercent":20,"defaults":{"enforce":true,"allowance":50000,"alertAt":80,"pauseAt":100,"pauseMessages":["marketing"]}}'
OPERATOR_API_KEY=        # openssl rand -hex 32; the platform operator's key (x-operator-key), not an agent's

# Voice (step 15). LiveKit dev mode runs in Compose with these fixed keys.
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret
LIVEKIT_NODE_IP=127.0.0.1     # your Mac's LAN IP to test from a phone on the same Wi-Fi
SARVAM_API_KEY=               # https://dashboard.sarvam.ai (speech-to-text and text-to-speech)
VOICE_AGENT_KEY=              # openssl rand -hex 32; the voice worker's own key, not AGENT_API_KEY
VOICE_MODE=live               # or fake: text in, spoken text and UI parts out, no audio
VOICE_DAILY_MINUTES=30        # per person; past it, POST /api/voice/session returns 429

# WhatsApp (step 16). whaloc stands in for Meta in development and CI: the adapter only
# knows a Graph URL, so switching to Meta is configuration.
WA_GRAPH_URL=http://localhost:8080            # https://graph.facebook.com in staging and production
WA_API_VERSION=v25.0
WA_WABA_ID=666635535888644                    # the business account (whaloc's seed)
WA_PHONE_NUMBER_ID=573542517421694            # the number we send from (whaloc's seed)
WA_ACCESS_TOKEN=dev-token                     # a system-user token in production
WA_APP_SECRET=dev-app-secret                  # HMAC key for X-Hub-Signature-256; = WHALOC_APP_SECRET
WA_VERIFY_TOKEN=dev-verify-token              # Meta's GET webhook challenge
WA_SEND_RATE_PER_SEC=60                       # below Meta's default per-number throughput
APPROVAL_SECRET=                              # signs approval buttons: openssl rand -hex 32
SMTP_HOST=localhost                           # Mailpit in development (http://localhost:8025)
SMTP_PORT=1025
APP_URL=http://localhost:8081                 # links in messages (sign-in, pages, approvals)
