{
  "name": "@app/api",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev": "tsc -p tsconfig.json && concurrently -k -n tsc,api,worker \"tsc -p tsconfig.json -w --preserveWatchOutput\" \"node --env-file=../../.env --watch dist/main.js\" \"node --env-file=../../.env --watch dist/worker.js\"",
    "start": "node --env-file=../../.env dist/main.js",
    "start:worker": "node --env-file=../../.env dist/worker.js",
    "templates:sync": "node --env-file=../../.env dist/channels/templates/cli.js sync",
    "templates:check": "node --env-file=../../.env dist/channels/templates/cli.js check"
  },
  "dependencies": {
    "@app/agents": "workspace:*",
    "@app/api-client": "workspace:*",
    "@app/channels": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/core": "workspace:*",
    "@app/db": "workspace:*",
    "@app/i18n": "workspace:*",
    "@app/notifications": "workspace:*",
    "@app/policy": "workspace:*",
    "@app/ui-registry": "workspace:*",
    "@bull-board/api": "^9.10.4",
    "@bull-board/express": "^9.10.4",
    "@mastra/ai-sdk": "^1.10.6",
    "@mastra/core": "1.74.0",
    "@nest-lab/throttler-storage-redis": "^1.2.0",
    "@nestjs/bullmq": "^12.0.0",
    "@nestjs/common": "^11.2.7",
    "@nestjs/core": "^11.2.7",
    "@nestjs/cqrs": "^11.0.3",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/throttler": "^6.7.1",
    "@thallesp/nestjs-better-auth": "^2.8.0",
    "ai": "7.0.128",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.11",
    "drizzle-orm": "^0.45.3",
    "ioredis": "^6.0.0",
    "livekit-server-sdk": "2.19.1",
    "nestjs-zod": "^5.5.0",
    "nodemailer": "^10.0.15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "concurrently": "^10.0.5",
    "pg": "^8.23.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3",
    "yaml": "^2.9.1"
  }
}
