{
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["build"],
      "cache": false,
      "passThroughEnv": ["*"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "@application/api#test": {
      "dependsOn": ["build", "@hykr/api#test"],
      "cache": false,
      "passThroughEnv": ["*"]
    }
  }
}
