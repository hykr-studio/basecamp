{
  "name": "@app/agents",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json -w --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "studio": "node scripts/studio.mjs",
    "eval": "MODEL_MODE=fake tsx --env-file=../../.env evals/assistant.eval.ts",
    "eval:live": "MODEL_MODE=live tsx --env-file=../../.env evals/assistant.eval.ts",
    "eval:voice": "MODEL_MODE=fake tsx --env-file=../../.env evals/voice.eval.ts",
    "eval:voice:live": "MODEL_MODE=live tsx --env-file=../../.env evals/voice.eval.ts",
    "eval:whatsapp": "MODEL_MODE=fake tsx --env-file=../../.env evals/whatsapp.eval.ts",
    "eval:whatsapp:live": "MODEL_MODE=live tsx --env-file=../../.env evals/whatsapp.eval.ts"
  },
  "dependencies": {
    "@app/api-client": "workspace:*",
    "@app/contracts": "workspace:*",
    "@app/i18n": "workspace:*",
    "@app/core": "workspace:*",
    "@app/ui-registry": "workspace:*",
    "@mastra/core": "^1.74.0",
    "@mastra/evals": "^1.10.5",
    "@mastra/loggers": "^1.3.4",
    "@mastra/observability": "^1.18.3",
    "@mastra/pg": "^1.29.0",
    "ai": "7.0.128",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ai-sdk/provider": "^2.0.3",
    "@hono/node-server": "^1.19.17",
    "@mastra/hono": "^1.7.16",
    "hono": "^4.13.13",
    "mastra": "^1.32.1",
    "tsx": "^4.23.15"
  }
}
