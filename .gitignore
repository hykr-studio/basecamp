# One file for the whole monorepo. Patterns without a leading "/" match at any
# depth, so they cover the root, framework/* and application/* alike.

# ── Dependencies ────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnp.*
.yarn/

# ── Secrets & env ───────────────────────────────────────────────
# Real env files never get committed; .env.example (no values) is the template.
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.pfx
*.jks
*.keystore
!debug.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist
service-account*.json
credentials.json
.npmrc.local
.secrets/

# ── Build output ────────────────────────────────────────────────
dist/
build/
out/
*.tsbuildinfo
.turbo/
.cache/

# ── Tests & coverage ────────────────────────────────────────────
coverage/
.vitest/
*.lcov
junit.xml
test-results/

# ── Expo / React Native (application/mobile) ───────────────────────────
.expo/
.expo-shared/
web-build/
expo-env.d.ts
*.apk
*.aab
*.ipa
# Native projects generated by `expo prebuild`; drop these two lines if you
# commit native code instead.
/application/mobile/ios/
/application/mobile/android/

# ── Local data & logs ───────────────────────────────────────────
*.log
logs/
*.pid
*.sqlite
*.sqlite3
*.db
tmp/
.tmp/

# ── Editors, OS & local tooling ─────────────────────────────────
.DS_Store
Thumbs.db
.idea/
*.swp
*.swo
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.claude/settings.local.json
compose.override.yaml
docker-compose.override.yml

# Note: framework/db/drizzle/ and application/domain/drizzle/ (generated migrations) and pnpm-lock.yaml are
# meant to be committed — do not ignore them.

# Mastra dev server build and Studio presets
.mastra/
.studio/

# Agent worktrees (Claude Code)
.claude/worktrees/
.impeccable

# The framework's test fixture, compiled before its e2e tests run
/framework/api/test/fixture/dist/
/framework/create-basecamp/template/

# Redis snapshots from a local redis-server
dump.rdb
