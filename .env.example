DATABASE_URL=postgres://app:app@localhost:5432/app
MIGRATE_DATABASE_URL=postgres://app:app@localhost:5432/app
REDIS_URL=redis://localhost:6379
BETTER_AUTH_SECRET=      # openssl rand -hex 32
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGINS=http://localhost:8081
AGENT_API_KEY=           # openssl rand -hex 32
API_INTERNAL_URL=http://localhost:3000
OPENROUTER_API_KEY=
AGENT_MODEL=openrouter/openai/gpt-6-luna
MODEL_MODE=live          # fake = scripted model, no key needed
GUARDRAILS=off

WHATSAPP_API_BASE_URL=http://localhost:8080   # production: https://graph.facebook.com
WHATSAPP_TOKEN=dev-token
WHATSAPP_PHONE_NUMBER_ID=                     # copy from whaloc's settings page
WHATSAPP_APP_SECRET=dev-app-secret            # must match WHALOC_APP_SECRET
WHATSAPP_VERIFY_TOKEN=dev-verify-token
